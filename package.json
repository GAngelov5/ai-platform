{
  "name": "ai-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@platform/api --filter=@platform/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @platform/worker run cli migrate",
    "db:seed": "pnpm --filter @platform/worker run cli seed",
    "smoke": "node scripts/smoke.mjs",
    "live:lightrag": "node scripts/lightrag-live-check.mjs",
    "live:integrations": "node scripts/integration-live-check.mjs",
    "dev:full": "turbo run dev --filter=@platform/api --filter=@platform/web --filter=@platform/worker --filter=@platform/mcp-atlas-tracker",
    "dev:https": "node scripts/dev-https.mjs"
  },
  "devDependencies": {
    "docx": "9.9.0",
    "pdf-lib": "1.17.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
