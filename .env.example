# Example configuration. Copy to .env for local development; never commit .env.
# Secrets are supplied separately (environment / secret manager), not baked into images.

# --- Deployment -------------------------------------------------------------
APP_ENV=development            # development | test | production
CUSTOMER_ID=cust_demo          # must match fixtures/identities.json for the synthetic demo
BRAND_NAME=Company Brain (synthetic demo)
POLICY_VERSION=policy-2026-10-18.1
LOG_LEVEL=info

# --- Storage ----------------------------------------------------------------
# Local dev (pnpm dev) against the Compose Postgres exposed on 127.0.0.1:55432:
DATABASE_URL=postgres://platform:platform_dev@127.0.0.1:55432/platform
POSTGRES_PASSWORD=platform_dev # Compose only; production rejects development passwords
REDIS_URL=redis://127.0.0.1:6379

# --- HTTP / sessions ----------------------------------------------------------
API_PORT=4000
PUBLIC_ORIGIN=http://localhost:3000   # Compose: https://localhost:8443
COOKIE_SECURE=false                   # must be true in production
SESSION_TTL_MINUTES=480

# --- Identity -----------------------------------------------------------------
AUTH_MODE=dev                  # dev | oidc   (oidc is required in production; not implemented yet)
DEV_AUTH_ENABLED=true          # synthetic identities; rejected in production
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=          # secret reference, supply via secret manager

# --- Knowledge ----------------------------------------------------------------
KNOWLEDGE_PROVIDER=fixture     # fixture | ragflow
# FIXTURES_DIR=./fixtures/documents
# RAGFLOW_BASE_URL=http://ragflow:9380
# RAGFLOW_API_KEY=             # secret reference
# RAGFLOW_DATASET_ID=

# --- Model --------------------------------------------------------------------
MODEL_MODE=local               # local | hybrid (hybrid = explicitly approved external endpoint)
MODEL_PROVIDER=fake            # fake | openai-compatible
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1:8b
# MODEL_API_KEY=
# MODEL_APPROVED_ENDPOINTS=http://localhost:11434
