# Example configuration. Copy to .env for local development; never commit .env.
# Secrets are supplied separately (environment / secret manager), not baked into images.

# --- Deployment -------------------------------------------------------------
APP_ENV=development            # development | test | production
CUSTOMER_ID=cust_demo          # must match fixtures/identities.json for the synthetic demo
BRAND_NAME=Company Brain (synthetic demo)
POLICY_VERSION=policy-2026-10-18.1
LOG_LEVEL=info

# --- Storage ----------------------------------------------------------------
# Local dev (pnpm dev) against the Compose Postgres exposed on 127.0.0.1:55432:
DATABASE_URL=postgres://platform:platform_dev@127.0.0.1:55432/platform
POSTGRES_PASSWORD=platform_dev # Compose only; production rejects development passwords
REDIS_URL=redis://127.0.0.1:6379

# --- HTTP / sessions ----------------------------------------------------------
API_PORT=4000
PUBLIC_ORIGIN=http://localhost:3000   # Compose: https://localhost:8443
COOKIE_SECURE=false                   # must be true in production
SESSION_TTL_MINUTES=480

# --- Identity -----------------------------------------------------------------
AUTH_MODE=dev                  # dev | oidc   (oidc is required in production; not implemented yet)
DEV_AUTH_ENABLED=true          # synthetic identities; rejected in production
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=          # secret reference, supply via secret manager

# --- Knowledge ----------------------------------------------------------------
KNOWLEDGE_PROVIDER=fixture     # fixture | lightrag | ragflow
# FIXTURES_DIR=./fixtures/documents
# Sources to ingest (ADR 0009). Unset = synthetic defaults: Atlas fixtures + fixtures/sources/team-share.
# KNOWLEDGE_SOURCES=[{"id":"team-share","title":"Team share","kind":"folder","settings":{"path":"/data/share"},"aclMap":{"SHARE\\Atlas":"atlas-team"}}]
# INGEST_INTERVAL_MINUTES=15
# LightRAG (see infra/compose/lightrag/compose.lightrag.yaml for a full example):
# LIGHTRAG_API_KEY=            # secret reference; >= 24 chars in production
# LIGHTRAG_PARTITIONS=[{"id":"p_atlas_team","url":"http://lightrag-atlas-team:9621","sourceId":"atlas-project-docs","aclGroups":["atlas-team"]}]
# LIGHTRAG_QUERY_MODE=mix      # naive | local | global | hybrid | mix
# LIGHTRAG_RANKING=lexical      # lexical (term overlap) | native (LightRAG's own order)
# Evidence score (ADR 0010): lexical term overlap, or embedding similarity via local Ollama.
# EVIDENCE_SCORING=semantic
# EMBEDDING_BASE_URL=http://ollama:11434
# EMBEDDING_MODEL=nomic-embed-text
# SEMANTIC_SCORE_FLOOR / SEMANTIC_SCORE_CEIL: cosine mapped to score 0 and 1 (calibrated defaults)
# RAGFLOW_BASE_URL=http://ragflow-cpu:9380
# RAGFLOW_API_KEY=             # secret reference
# RAGFLOW_DATASET_ID=

# --- Model --------------------------------------------------------------------
MODEL_MODE=local               # local | hybrid (hybrid = explicitly approved external endpoint)
MODEL_PROVIDER=fake            # fake | openai-compatible
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1:8b
# MODEL_API_KEY=
# MODEL_APPROVED_ENDPOINTS=http://localhost:11434

# --- Local integrations (pnpm dev:full) -------------------------------------
# Synthetic tracker MCP server on the host, used by the local API and worker.
TRACKER_TOKEN=dev-tracker-token-0123456789abcd
TRACKER_PORT=8090
TRACKER_DATA_FILE=.local/tracker.json
# Synthetic calendar at /calendar/mcp, and the status-change test hook (Stage 3c).
CALENDAR_TOKEN=dev-calendar-token-0123456789abcd
TRACKER_TEST_HOOKS=1
MCP_TOKEN_ATLAS_TRACKER=dev-tracker-token-0123456789abcd
MCP_TOKEN_CALENDAR=dev-calendar-token-0123456789abcd
MCP_SERVERS=[{"id":"atlas-tracker","url":"http://localhost:8090/mcp","pinnedTools":{"tasks_list":"64df1f1cd397b9a68f9f61985281f600690d34fe13fdf3a940b875e7b7fc56f2","task_status":"15f87884badb2a52ebd8fc8c145e5b1781a53e503cae602d8e486df925934655","task_add_comment":"62fcea50f2e7b05296caafeaf3bc586dbfffa1a9939afb9eb510d63550fbf03b","task_find_comment":"3b084587549d5d1e7528910f0ffe501db9f8b2d97e06c86587ad5b99ad98cebf"}},{"id":"calendar","url":"http://localhost:8090/calendar/mcp","pinnedTools":{"events_list":"41f3c155289f2a8f9f4a23aacb02f35d44e86670b051f617766149062cd1108b"}}]

# --- Google Calendar and Notion (ADR 0015, docs/INTEGRATIONS-SETUP.md) -------
# Each user connects their own Google account under "Your connections" (read-only calendar).
# Redirect URI to register in Google Cloud: <PUBLIC_ORIGIN>/api/connections/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Seals stored Google tokens. Generate with: openssl rand -base64 32
# CONNECTION_ENCRYPTION_KEY=
# Notion: either a public integration, so an admin clicks "Connect Notion" and picks pages on Notion's screen
# (redirect URI: <PUBLIC_ORIGIN>/api/connections/notion/callback) ...
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# ... or an internal integration secret, with pages shared to it in Notion.
# NOTION_TOKEN=
# Platform groups that may read every shared Notion page (comma-separated).
# NOTION_ACL_GROUPS=all-staff
