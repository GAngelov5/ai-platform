{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "LICENCE_FILE",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "CONNECTION_ENCRYPTION_KEY",
        "NOTION_TOKEN",
        "NOTION_ACL_GROUPS",
        "NOTION_OAUTH_CLIENT_SECRET",
        "NOTION_OAUTH_CLIENT_ID",
        "HTTPS_PROXY",
        "NO_PROXY",
        "NODE_USE_ENV_PROXY"
      ]
    }
  }
}
