{
	# Development TLS from Caddy's internal CA. Replace with the customer's
	# certificate (tls /path/cert.pem /path/key.pem) for a real deployment.
	admin off
	auto_https disable_redirects
	http_port 8080
	https_port 8443
}

{$PUBLIC_HOST:localhost}:8443 {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /api/* {
		# No compression here: run progress is streamed as text/event-stream.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
